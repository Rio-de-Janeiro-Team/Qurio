<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="#1F49BAF2"
                android:centerColor="#050C10"
                android:endColor="#1F49BAF2"
                android:type="linear" />
        </shape>
    </item>

    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <solid android:color="#0B0F14"/>
        </shape>
    </item>

</layer-list>