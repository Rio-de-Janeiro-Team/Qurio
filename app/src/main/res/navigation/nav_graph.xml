<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/onBoardingFragment">

    <fragment
        android:id="@+id/tempFragment"
        android:name="com.example.qurio.presentation.view.TempFragment"
        android:label="TempFragment"
        tools:layout="@layout/fragment_temp" />

    <fragment
        android:id="@+id/itemQuestionFragment"
        android:name="com.example.qurio.presentation.view.game.GameFragment"
        android:label="fragment_questions"
        tools:layout="@layout/fragment_start_paly" />
    <fragment
        android:id="@+id/onBoardingFragment"
        android:name="com.example.qurio.presentation.fragment.OnBoardingFragment"
        android:label="OnBoardingFragment">

        <action
            android:id="@+id/action_onBoardingFragment_to_tempFragment"
            app:destination="@id/tempFragment" />


        <action
            android:id="@+id/action_onBoardingFragment_to_itemQuestionFragment"
            app:destination="@id/itemQuestionFragment" />

    </fragment>


</navigation>