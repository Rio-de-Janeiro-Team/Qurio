<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:backgroundTint="@android:color/transparent"
    >

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/category_image"
        android:layout_width="0dp"
        android:layout_height="260dp"
        android:clipToOutline="true"
        android:foreground="#33000000"
        android:scaleType="centerCrop"
        android:src="@drawable/history"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/CutCornerImage"
        app:strokeColor="@color/design_default_color_on_primary"
        app:strokeWidth="4dp" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/gradient_overlay"
        android:layout_width="0dp"
        android:layout_height="107dp"
        android:background="@drawable/gradient_overlay"
        app:layout_constraintBottom_toBottomOf="@id/category_image"
        app:layout_constraintEnd_toEndOf="@id/category_image"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@id/category_image"
        app:layout_constraintTop_toTopOf="@id/category_image"
        app:layout_constraintVertical_bias="1.0"
        app:shapeAppearanceOverlay="@style/CutCornerOverlay" />

    <TextView
        android:id="@+id/category_label"
        style="@style/title.large"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:gravity="center"
        android:text="?attr/cardLabel"
        android:textColor="@color/on_primary"
        app:layout_constraintBottom_toTopOf="@+id/play_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/recent_game_left_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        android:src="@drawable/recent_game_left_shadow"
        android:translationX="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/play_button"
        app:layout_constraintEnd_toStartOf="@+id/play_button"
        app:layout_constraintTop_toBottomOf="@+id/category_label" />

    <ImageView
        android:id="@+id/recent_game_right_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        android:src="@drawable/recent_game_right_shadow"
        android:translationX="-8dp"
        app:layout_constraintBottom_toBottomOf="@+id/play_button"
        app:layout_constraintStart_toEndOf="@+id/play_button"
        app:layout_constraintTop_toBottomOf="@+id/category_label" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/play_button"
        style="@style/qurioButton.playButton.large"
        android:layout_width="148dp"
        android:layout_height="44dp"
        android:backgroundTint="@null"
        android:enabled="false"
        android:text="@string/play_now"
        app:layout_constraintBottom_toBottomOf="@+id/category_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/category_image" />

</androidx.constraintlayout.widget.ConstraintLayout>