<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingBottom="24dp"
    android:paddingEnd="24dp"
    android:paddingStart="24dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/category_image"
        android:layout_width="270dp"
        android:layout_height="344dp"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:foreground="#33000000"
        android:src="?attr/cardImage"
        app:shapeAppearanceOverlay="@style/CutCornerImage"
        app:strokeColor="?attr/cardStrokeColor"
        app:strokeWidth="3dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/gradient_overlay"
        android:layout_width="0dp"
        android:layout_height="107dp"
        app:shapeAppearanceOverlay="@style/CutCornerOverlay"
        android:background="@drawable/gradient_overlay"
        app:layout_constraintBottom_toBottomOf="@id/category_image"
        app:layout_constraintEnd_toEndOf="@id/category_image"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@id/category_image"
        app:layout_constraintTop_toTopOf="@id/category_image"
        app:layout_constraintVertical_bias="1.0" />

    <TextView
        android:id="@+id/category_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="?attr/cardLabel"
        android:textColor="@color/design_default_color_on_primary"
        android:padding="8dp"
        style="@style/title.large"
        app:layout_constraintBottom_toTopOf="@+id/play_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/play_button"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:text="Play Now"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:textColor="@color/design_default_color_on_primary"
        android:backgroundTint="@color/primary"
        android:fontFamily="@font/fredoka_one_regular"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="@+id/category_image"
        app:layout_constraintTop_toBottomOf="@+id/category_image"
        app:layout_constraintVertical_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>