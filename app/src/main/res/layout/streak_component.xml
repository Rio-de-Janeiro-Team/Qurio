<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:background="@drawable/background_card">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/streak"
            android:layout_width="48dp"
            android:layout_height="70dp"
            android:layout_marginHorizontal="16dp"
            android:src="@drawable/streak"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/linear_text"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/linear_text"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginVertical="7dp"
            android:layout_marginEnd="28dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/streak"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                style="@style/label.medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 day streak, start make a series"
                android:textColor="@color/shade_primary" />

            <TextView
                style="@style/label.xsmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/every_day_count"
                android:textColor="@color/shade_secondary" />

            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:ignore="MissingConstraints"
                tools:itemCount="7"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                android:layout_marginTop="4dp"
                tools:listitem="@layout/streak_item" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>