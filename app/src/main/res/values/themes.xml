<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.Qurio" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.Qurio" parent="Base.Theme.Qurio" />

    <style name="CutCornerImage">
        <item name="cornerFamilyTopLeft">cut</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerFamilyTopRight">cut</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerFamilyBottomLeft">cut</item>
        <item name="cornerSizeBottomLeft">12dp</item>
        <item name="cornerFamilyBottomRight">cut</item>
        <item name="cornerSizeBottomRight">12dp</item>
    </style>

    <style name="CutCornerOverlay" parent="">
        <item name="cornerFamilyBottomLeft">cut</item>
        <item name="cornerSizeBottomLeft">12dp</item>
        <item name="cornerFamilyBottomRight">cut</item>
        <item name="cornerSizeBottomRight">12dp</item>
    </style>

    <style name="headline">
        <item name="android:fontFamily">@font/fredoka_one_regular</item>
    </style>

    <style name="headline.large">
        <item name="android:textSize">28sp</item>
        <item name="lineHeight">42sp</item>
    </style>
    <style name="headline.medium">
        <item name="android:textSize">24sp</item>
        <item name="lineHeight">36sp</item>
    </style>
    <style name="headline.small">
        <item name="android:textSize">20sp</item>
        <item name="lineHeight">30sp</item>
    </style>


    <style name="title">
        <item name="android:fontFamily">@font/fredoka_one_regular</item>
    </style>

    <style name="title.large">
        <item name="android:textSize">20sp</item>
        <item name="lineHeight">30sp</item>
    </style>
    <style name="title.medium">
        <item name="android:textSize">18sp</item>
        <item name="lineHeight">28sp</item>
    </style>
    <style name="title.small">
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">24sp</item>
    </style>


    <style name="body">
        <item name="android:fontFamily">@font/fredoka_regular</item>
    </style>

    <style name="body.large">
        <item name="android:textSize">18sp</item>
        <item name="lineHeight">28sp</item>
    </style>
    <style name="body.medium">
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">24sp</item>
    </style>
    <style name="body.small">
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">22sp</item>
    </style>

    <style name="label">
        <item name="android:fontFamily">@font/fredoka_one_regular</item>
    </style>

    <style name="label.large">
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">24sp</item>
    </style>
    <style name="label.medium">
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">22sp</item>
    </style>
    <style name="label.small">
        <item name="android:textSize">10sp</item>
        <item name="lineHeight">16sp</item>
    </style>
    <style name="label.xsmall">
        <item name="android:textSize">10sp</item>
        <item name="lineHeight">14sp</item>
        <item name="android:fontFamily">@font/fredoka_regular</item>
    </style>

<!--    buttons -->
    <style name="qurioButton">
        <item name="android:fontFamily">@font/fredoka_one_regular</item>
    </style>

    <style name="qurioButton.playButton">
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="qurioButton.playButton.large">
        <item name="android:background">@drawable/button_play_large_bg</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="qurioButton.playButton.small">
        <item name="android:background">@drawable/button_play_bg</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="qurioButton.outline">
        <item name="android:background">@drawable/button_outlined_bg</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="qurioButton.rounded12dp">
        <item name="android:background">@drawable/button_rounded_12dp</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="qurioButton.rounded16dp">
        <item name="android:background">@drawable/button_rounded_16dp</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>